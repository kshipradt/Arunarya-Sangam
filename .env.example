# Public configuration, baked into the browser bundle at build time.
# Never put secret keys here: everything in this file is visible to every visitor.

# Supabase project URL and PUBLISHABLE key (Project Settings > API Keys).
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cloudflare Turnstile SITE key (the secret key goes into Supabase > Auth > Bot protection).
# 1x00000000000000000000AA is Cloudflare's official always-pass test key for development.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Show "Continue with Google" only after the Google provider is configured in Supabase.
PUBLIC_GOOGLE_SIGN_IN=false

# Full site address, used for email links (sign-up confirmation, password reset).
PUBLIC_SITE_URL=http://localhost:5173

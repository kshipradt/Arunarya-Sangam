    "e2e": "node e2e/run.mjs",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "playwright": "1.56.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.2"
  }
}

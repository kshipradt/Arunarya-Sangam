{
  "name": "arunarya-sangam",
  "version": "0.1.0",
  "private": true,
  "description": "ARUNARYA Sangam: a multilingual marketplace and network for India's One District One Product (ODOP) crafts.",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
